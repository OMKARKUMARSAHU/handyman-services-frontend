# Handyman Services backend — environment variable names only.
# Never commit an actual .env file with real values (see .gitignore).
# Production secrets belong in AWS Secrets Manager / SSM Parameter Store
# (PHASE_2_AWS_ARCHITECTURE.md §20) — this file is for local development only.

# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
# API_PUBLIC_BASE_URL: this backend's own externally-reachable origin (no
# trailing slash) -- used only to build the media redirect URL returned to
# clients (GET <API_PUBLIC_BASE_URL><API_BASE_PATH>/media/file/<key>).
# Defaults to the local dev backend address; set to the real public origin
# (the EB environment URL, or a custom domain in front of it) in production.
API_PUBLIC_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# Blog scheduled-publishing timer (ms). 0 disables the timer.
BLOG_SCHEDULER_INTERVAL_MS=60000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (RDS MySQL in production; local MySQL in development) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=handyman_dev
# DB_TEST_NAME: a SEPARATE, disposable database the `test` NODE_ENV profile points at
# (src/database/knexfile.ts) — `npm test` truncates its tables between tests, so this
# must never be the same value as DB_NAME.
DB_TEST_NAME=handyman_test
DB_USER=handyman_app
# DB_PASSWORD is a secret — set it in your local, untracked .env only.
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- Amazon Cognito ---
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CUSTOMER_APP_CLIENT_ID=
COGNITO_ADMIN_PROVIDER_APP_CLIENT_ID=
# Only needed if a confidential app client is used — secret, never in the frontend.
COGNITO_ADMIN_PROVIDER_APP_CLIENT_SECRET=

# --- Amazon S3 ---
S3_BUCKET_NAME=
S3_REGION=ap-south-1
# S3_UPLOAD_URL_TTL_SECONDS: how long a pre-signed upload URL stays valid.
S3_UPLOAD_URL_TTL_SECONDS=300
# S3_MAX_UPLOAD_BYTES: per-file upload size ceiling enforced before issuing a pre-signed URL (images; also the fallback for Catalog's own service-image uploads).
S3_MAX_UPLOAD_BYTES=10485760
# S3_MAX_VIDEO_UPLOAD_BYTES: same ceiling, but for video uploads through the Central Media Library (default 200MB — the 10MB image cap above is unworkable for real video clips).
S3_MAX_VIDEO_UPLOAD_BYTES=209715200

# --- AWS (only needed for local dev against S3; in ECS Fargate the task's
#     IAM role supplies credentials automatically — never set these in
#     production configuration) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Payment gateway (Razorpay) ---
# Resolves the previous TBD (PHASE_1_BACKEND_REQUIREMENTS_ANALYSIS.md,
# PHASE_2_BACKEND_DATABASE_SCHEMA.md §14) — Razorpay, TEST MODE only.
# Get these from the Razorpay Dashboard -> Settings -> API Keys, with
# "Test Mode" toggled on (test keys look like rzp_test_...). NEVER put the
# actual values in this file -- set them only in your local, untracked .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
