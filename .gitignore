# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except the AWS RDS CA bundle the production backend needs at runtime
# to verify its TLS connection to RDS (backend/src/database/knexfile.ts) --
# this is AWS's own public certificate data (no private key, nothing
# secret), and must be committed/shipped or the production DB connection
# cannot validate its TLS handshake.
!backend/certs/rds-ca-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except .env.example files (variable NAMES only, never real values) --
# these must stay tracked so anyone cloning the repo knows which env vars
# to set (this was previously broken: the blanket .env* rule above was
# silently swallowing backend/.env.example too, so it was never actually
# committed despite backend/.gitignore's own comment claiming it was).
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal project documentation
PROJECT_DOCUMENTATION/


# IDE / editor
.vscode/
.idea/
*.swp

# OS
Thumbs.db

# logs
*.log

# local scratch / QA output (screenshots, ad-hoc reports) — never intended for the repo
/Claude outputs/

# Contains real, live secrets (AWS Cognito client secret / AWS IAM access key) -- never commit.
/MANUAL_TEST_ACCOUNTS.md
/RDS_TUNNEL_SETUP.md
